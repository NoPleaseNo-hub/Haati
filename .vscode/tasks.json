{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MoonHug: Compiler Truth Check (Prebuild + Full Check)",
            "type": "shell",
            "command": "odin",
            "args": ["run", "tools/mh", "--", "check"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "moonhug-odin",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+)\\((\\d+):(\\d+)\\)\\s+(Syntax Error|Error|Warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "MoonHug: Fast Check (~420ms, Skip Prebuild)",
            "type": "shell",
            "command": "odin",
            "args": ["run", "tools/mh", "--", "check", "--fast"],
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "moonhug-odin",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+)\\((\\d+):(\\d+)\\)\\s+(Syntax Error|Error|Warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "MoonHug: Build Editor (MoonHug.exe)",
            "type": "shell",
            "command": "odin",
            "args": ["run", "tools/mh", "--", "build"],
            "group": "build",
            "problemMatcher": {
                "owner": "moonhug-odin",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+)\\((\\d+):(\\d+)\\)\\s+(Syntax Error|Error|Warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "MoonHug: Build & Launch Editor",
            "type": "shell",
            "command": "odin",
            "args": ["run", "tools/mh", "--", "run"],
            "group": "build"
        }
    ]
}
