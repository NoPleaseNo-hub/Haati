#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct CompositeUBO
{
    float4 params;
};

struct main0_out
{
    float4 out_color [[color(0)]];
};

struct main0_in
{
    float2 frag_uv [[user(locn0)]];
};

static inline __attribute__((always_inline))
float3 aces_fitted(thread const float3& x)
{
    return fast::clamp((x * ((x * 2.5099999904632568359375) + float3(0.02999999932944774627685546875))) / ((x * ((x * 2.4300000667572021484375) + float3(0.589999973773956298828125))) + float3(0.14000000059604644775390625)), float3(0.0), float3(1.0));
}

fragment main0_out main0(main0_in in [[stage_in]], constant CompositeUBO& _60 [[buffer(0)]], texture2d<float> u_hdr [[texture(0)]], texture2d<float> u_bloom [[texture(1)]], sampler u_hdrSmplr [[sampler(0)]], sampler u_bloomSmplr [[sampler(1)]])
{
    main0_out out = {};
    float4 hdr = u_hdr.sample(u_hdrSmplr, in.frag_uv);
    float3 col = fast::max(hdr.xyz, float3(0.0));
    if (_60.params.w > 0.5)
    {
        float3 bloom = fast::max(u_bloom.sample(u_bloomSmplr, in.frag_uv).xyz, float3(0.0));
        col += (bloom * _60.params.y);
    }
    col *= _60.params.x;
    if (_60.params.z > 0.5)
    {
        float3 param = col;
        col = aces_fitted(param);
    }
    else
    {
        col = fast::clamp(col, float3(0.0), float3(1.0));
    }
    float3 srgb = pow(fast::max(col, float3(0.0)), float3(0.4545454680919647216796875));
    out.out_color = float4(srgb, fast::clamp(hdr.w, 0.0, 1.0));
    return out;
}

